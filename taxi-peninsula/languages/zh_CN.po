#. translators: %s: suburb
msgid "Guides for %s"
msgstr "%s 出行指南"

#. translators: %s: suburb
msgid "Questions about travelling in %s"
msgstr "关于在 %s 出行的问题"

msgid "Nearby areas"
msgstr "附近区域"

