msgstr "我们服务的其他区域"

msgid "Book this trip"
msgstr "预约此行程"

msgid "More services"
msgstr "更多服务"

msgid "Ready to book?"
msgstr "准备好预约了吗？"

msgid "Other services"
msgstr "其他服务"

msgid "Pages:"
msgstr "页码："

