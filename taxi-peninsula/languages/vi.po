msgstr "Tiểu sử ngắn"

msgid ""
"e.g. Driving on the Peninsula for 8 years. Loves the footy and a good chat."
msgstr ""
"ví dụ: Lái xe ở bán đảo 8 năm. Mê bóng bầu dục Úc và thích trò chuyện."

msgid "Choose photo"
msgstr "Chọn ảnh"

