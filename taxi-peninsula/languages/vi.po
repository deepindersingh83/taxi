msgstr "Xin cảm ơn — chúng tôi đã nhận được yêu cầu của bạn."

msgid "Our team will contact you to confirm."
msgstr "Đội ngũ của chúng tôi sẽ liên lạc với bạn để xác nhận."

msgid "Payment complete — thank you."
msgstr "Đã thanh toán xong — xin cảm ơn."

msgid "It can take a minute for the payment to show below."
msgstr "Có thể mất khoảng một phút để khoản thanh toán hiện ở bên dưới."

msgid ""
"The payment was not completed. You can try again below or pay the driver."
msgstr ""
"Thanh toán chưa hoàn tất. Bạn có thể thử lại bên dưới hoặc trả tiền cho tài "
"xế."

msgid "This booking has been cancelled."
msgstr "Lịch đặt xe này đã bị hủy."

msgid ""
"Our driver arrived but could not find you, so this trip was marked as a no-"
"show. Please call us if this is a mistake."
msgstr ""
"Tài xế của chúng tôi đã đến nhưng không tìm thấy bạn, nên chuyến đi này được"
" ghi là khách không có mặt. Xin gọi cho chúng tôi nếu đây là nhầm lẫn."

msgid "Your driver is on the way."
msgstr "Tài xế của bạn đang trên đường đến."

msgid "Your driver has arrived."
msgstr "Tài xế của bạn đã đến nơi."

msgid "Booking progress"
msgstr "Tiến trình đặt xe"

msgid "Time to be arranged"
msgstr "Giờ sẽ được sắp xếp sau"

#. translators: 1: passengers, 2: wheelchairs
msgid "%1$d passenger(s), %2$d wheelchair(s)"
msgstr "%1$d hành khách, %2$d xe lăn"

msgid "estimate only"
msgstr "chỉ là ước tính"

msgid "Your notes"
msgstr "Ghi chú của bạn"

#. translators: %s: amount
msgid "Pay %s deposit securely"
msgstr "Trả tiền cọc %s an toàn"

#. translators: %d: number of trips
msgid "This is part of a repeat booking (%d trips)"
msgstr "Đây là một phần của lịch đặt xe lặp lại (%d chuyến)"

#. translators: %s: request type
msgid "Your %s is with our team. We will contact you shortly."
msgstr ""
"Đội ngũ của chúng tôi đã nhận %s của bạn. Chúng tôi sẽ sớm liên lạc với bạn."

msgid "Change or cancel this booking"
msgstr "Thay đổi hoặc hủy lịch đặt xe này"

msgid "What would you like to do?"
msgstr "Bạn muốn làm gì?"

