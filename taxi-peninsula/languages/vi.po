msgstr "Địa chỉ email bạn đã dùng để đặt xe"

msgid "We email you a link to confirm it is really you."
msgstr "Chúng tôi sẽ gửi email cho bạn một liên kết để xác nhận đúng là bạn."

msgid "Send request"
msgstr "Gửi yêu cầu"

#. translators: 1: request type, 2: masked email
msgid "Privacy request received (%1$s) from %2$s — waiting for email confirmation"
msgstr "Đã nhận yêu cầu về quyền riêng tư (%1$s) từ %2$s — đang chờ xác nhận qua email"

msgid "delete"
msgstr "xóa"

msgid "copy"
msgstr "bản sao"

msgid "Your privacy"
msgstr "Quyền riêng tư của bạn"

msgid "You can download everything we hold about you, or close your account."
msgstr "Bạn có thể tải xuống mọi thông tin chúng tôi lưu về bạn, hoặc đóng tài khoản."

msgid "Read our privacy policy"
msgstr "Đọc chính sách quyền riêng tư của chúng tôi"

msgid "Download my data"
msgstr "Tải dữ liệu của tôi"

msgid "A file with your details, trips, saved passengers and addresses."
msgstr "Một tệp gồm thông tin của bạn, các chuyến đi, hành khách và địa chỉ đã lưu."

msgid "Delete my account"
msgstr "Xóa tài khoản của tôi"

#. translators: %s: phone
msgid "You have upcoming trips. Please cancel them first, or call us on %s, then come back to delete your account."
msgstr "Bạn có chuyến đi sắp tới. Xin hủy các chuyến đó trước, hoặc gọi cho chúng tôi theo số %s, rồi quay lại để xóa tài khoản."

msgid "This signs you out and deletes your account, saved passengers, clients and addresses. Names, contact details and street addresses are removed from your past trips. We keep the trip reference, date, suburbs and fare for our records, and invoice details for 5 years because tax law requires it."
msgstr "Thao tác này sẽ đăng xuất và xóa tài khoản, hành khách, khách hàng và địa chỉ đã lưu của bạn. Tên, thông tin liên lạc và địa chỉ nhà sẽ được xóa khỏi các chuyến đi trước đây. Chúng tôi giữ lại mã đặt xe, ngày, khu vực và giá cước để lưu hồ sơ, và giữ thông tin hóa đơn trong 5 năm vì luật thuế yêu cầu."

msgid "Your password"
msgstr "Mật khẩu của bạn"

msgid "I understand this cannot be undone."
msgstr "Tôi hiểu rằng việc này không thể hoàn tác."

msgid "Customer downloaded their data from My Account"
msgstr "Khách hàng đã tải dữ liệu của họ từ Tài khoản của tôi"

msgid "Your password was not right, so your account was not deleted."
msgstr "Mật khẩu của bạn không đúng, nên tài khoản chưa bị xóa."

msgid "You have upcoming trips. Please cancel them first."
msgstr "Bạn có chuyến đi sắp tới. Xin hủy các chuyến đó trước."

msgid "Customer deleted their account"
msgstr "Khách hàng đã xóa tài khoản của họ"

#. translators: %s: masked email
msgid "Customer account deleted (%s)"
msgstr "Đã xóa tài khoản khách hàng (%s)"

msgid "A customer deleted their account"
msgstr "Một khách hàng đã xóa tài khoản của họ"

#. translators: %d: number of trips
msgid "A customer account was deleted from My Account. Personal details were removed from %d trips; references, dates, suburbs and fares were kept."
msgstr "Một tài khoản khách hàng đã bị xóa từ Tài khoản của tôi. Thông tin cá nhân đã được xóa khỏi %d chuyến đi; mã đặt xe, ngày, khu vực và giá cước vẫn được giữ lại."

msgid "Thanks for sharing your experience on Google!"
msgstr "Cảm ơn bạn đã chia sẻ trải nghiệm trên Google!"

msgid "Would you share your experience on Google?"
msgstr "Bạn có muốn chia sẻ trải nghiệm của mình trên Google không?"

msgid "A short review helps other families and carers find accessible transport they can trust. It takes about a minute."
msgstr "Một bài đánh giá ngắn giúp các gia đình và người chăm sóc khác tìm được dịch vụ đi lại cho người khuyết tật mà họ có thể tin cậy. Chỉ mất khoảng một phút."

msgid "Write a Google review"
msgstr "Viết đánh giá trên Google"

msgid "Customer opened the Google review link"
msgstr "Khách hàng đã mở liên kết đánh giá Google"

msgid "there"
msgstr "bạn"

msgid "Thank you for rating your trip with us — it really helps."
msgstr "Cảm ơn bạn đã đánh giá chuyến đi với chúng tôi — điều này thực sự hữu ích."

msgid "Would you also share your experience on Google? A short review helps other families and carers find accessible transport they can trust."
msgstr "Bạn có muốn chia sẻ thêm trải nghiệm của mình trên Google không? Một bài đánh giá ngắn giúp các gia đình và người chăm sóc khác tìm được dịch vụ đi lại cho người khuyết tật mà họ có thể tin cậy."

msgid "Thank you for travelling with us."
msgstr "Cảm ơn bạn đã đi xe cùng chúng tôi."

msgid "Thank you for your rating"
msgstr "Cảm ơn bạn đã đánh giá"

msgid "Google review invitation emailed"
msgstr "Đã gửi email mời đánh giá trên Google"

msgid "Please complete the \"I am human\" check and try again."
msgstr "Xin hoàn thành bước kiểm tra \"Tôi là người\" rồi thử lại."

#. translators: 1: area, 2: phone
msgid "Wheelchair accessible taxi in %1$s. Ramp and hoist vehicles, trained drivers, door-to-door. Book online or call %2$s."
msgstr "Taxi cho xe lăn tại %1$s. Xe có dốc lên xuống và thang nâng, tài xế được đào tạo, đưa đón tận nơi. Đặt xe trực tuyến hoặc gọi %2$s."

msgid "Wheelchair accessible taxi services in Melbourne: hospital and medical trips, airport transfers, NDIS and aged-care transport, group travel and events."
msgstr "Dịch vụ taxi cho xe lăn tại Melbourne: chuyến đi bệnh viện và khám bệnh, đưa đón sân bay, đi lại cho NDIS và người cao tuổi, đi nhóm và sự kiện."

msgid "Suburbs we cover with wheelchair accessible taxis across Melbourne and the Mornington Peninsula."
msgstr "Các khu vực chúng tôi phục vụ bằng taxi cho xe lăn khắp Melbourne và bán đảo Mornington."

msgid "News and travel tips for passengers using wheelchair accessible taxis in Melbourne."
