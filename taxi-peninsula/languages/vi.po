msgstr "Các yêu cầu do đội ngũ của chúng tôi xử lý. Nếu cần thay đổi trong vòng hai giờ tới, xin gọi cho chúng tôi."

#. translators: %s: phone link
msgid "Questions about your trip? Call %s."
msgstr "Có thắc mắc về chuyến đi? Xin gọi %s."

msgid "Thanks — your booking request is in!"
msgstr "Xin cảm ơn — yêu cầu đặt xe của bạn đã được gửi!"

msgid "Your reference"
msgstr "Mã đặt xe của bạn"

#. translators: %d: number of trips
