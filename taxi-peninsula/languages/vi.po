msgstr "Lịch đặt xe này đã bị hủy."

msgid "Our driver arrived but could not find you, so this trip was marked as a no-show. Please call us if this is a mistake."
msgstr "Tài xế của chúng tôi đã đến nhưng không tìm thấy bạn, nên chuyến đi này được ghi là khách không có mặt. Xin gọi cho chúng tôi nếu đây là nhầm lẫn."

msgid "Your driver is on the way."
msgstr "Tài xế của bạn đang trên đường đến."

msgid "Your driver has arrived."
msgstr "Tài xế của bạn đã đến nơi."

msgid "Booking progress"
msgstr "Tiến trình đặt xe"

msgid "Time to be arranged"
msgstr "Giờ sẽ được sắp xếp sau"

#. translators: 1: passengers, 2: wheelchairs
