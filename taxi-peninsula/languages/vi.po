msgstr "Chúng tôi không thể ước tính chuyến đi này trực tuyến. Chúng tôi sẽ xác nhận giá cước với bạn."

msgid "Address suggestions by Google"
msgstr "Gợi ý địa chỉ do Google cung cấp"

