msgstr "Cho thấy dốc lên xuống hoặc thang nâng, dây cố định xe lăn và bên trong xe. Hãy thêm văn bản thay thế và chú thích cho mọi ảnh — chúng sẽ được đọc lên trong chế độ xem toàn màn hình."

msgid "Partners"
msgstr "Đối tác"

msgid "Partner"
msgstr "Đối tác"

msgid "Add partner"
msgstr "Thêm đối tác"

msgid "Edit partner"
msgstr "Sửa đối tác"

msgid "Logo"
msgstr "Logo"

msgid "Set logo"
msgstr "Đặt logo"

msgid "Partner details"
msgstr "Thông tin đối tác"

msgid "Website (optional)"
msgstr "Trang web (không bắt buộc)"

msgid "We have written permission to show this logo"
msgstr "Chúng tôi có văn bản cho phép hiển thị logo này"

msgid "The logo stays hidden until this is ticked."
msgstr "Logo sẽ bị ẩn cho đến khi mục này được đánh dấu."

msgid "Ask for a copy of your information, or for it to be deleted"
msgstr "Yêu cầu bản sao thông tin của bạn, hoặc yêu cầu xóa thông tin"

msgid "Thank you. Please check your email and click the link to confirm the request — we then reply within 30 days."
msgstr "Xin cảm ơn. Xin kiểm tra email và bấm vào liên kết để xác nhận yêu cầu — sau đó chúng tôi sẽ trả lời trong vòng 30 ngày."

msgid "Sorry, we could not send that. Please check the email address, or call us."
msgstr "Xin lỗi, chúng tôi không gửi được. Xin kiểm tra lại địa chỉ email, hoặc gọi cho chúng tôi."

#. translators: %s: link to My Account
msgid "You are signed in, so you can download your data or delete your account straight away under %s."
msgstr "Bạn đã đăng nhập, nên bạn có thể tải dữ liệu của mình hoặc xóa tài khoản ngay tại %s."

msgid "My Account → My details"
msgstr "Tài khoản của tôi → Thông tin của tôi"

msgid "What would you like?"
msgstr "Bạn muốn yêu cầu gì?"

msgid "A copy of the information you hold about me"
msgstr "Bản sao thông tin quý công ty đang lưu về tôi"

msgid "Delete my information"
msgstr "Xóa thông tin của tôi"

