msgid "I need a return trip"
msgstr "Tôi cần chuyến về"

msgid "Return pick-up time (if known)"
msgstr "Giờ đón chuyến về (nếu biết)"

msgid "This is a regular trip (e.g. dialysis, therapy, day program)"
msgstr "Đây là chuyến đi định kỳ (ví dụ: lọc thận, trị liệu, chương trình ban ngày)"

msgid "Repeat every"
msgstr "Lặp lại vào mỗi"

msgid "Until"
msgstr "Đến ngày"

#. translators: %d: weeks
msgid "Same times each day, for up to %d weeks. Each trip gets its own reference so it can be changed separately."
msgstr "Cùng giờ mỗi ngày, tối đa %d tuần. Mỗi chuyến có mã đặt xe riêng để có thể thay đổi riêng từng chuyến."

msgid "Accessibility needs"
msgstr "Nhu cầu hỗ trợ đi lại"

msgid "I am a Multi Purpose Taxi Program (MPTP) member"
msgstr "Tôi là thành viên Chương trình Taxi Đa Mục đích của bang Victoria (MPTP)"

msgid "Anything we should know?"
msgstr "Chúng tôi cần biết thêm điều gì không?"

msgid "e.g. wheelchair dimensions, carer travelling, assistance to the door, flight number"
msgstr "ví dụ: kích thước xe lăn, có người chăm sóc đi cùng, cần giúp đến tận cửa, số hiệu chuyến bay"

msgid "How will you pay?"
msgstr "Bạn sẽ thanh toán bằng cách nào?"

msgid "Plan manager, provider or company"
msgstr "Người quản lý chương trình, nhà cung cấp dịch vụ hoặc công ty"

msgid "NDIS number or purchase order (optional)"
msgstr "Số NDIS hoặc số đơn đặt hàng (không bắt buộc)"

msgid "After you submit, you will be taken to Stripe’s secure checkout to pay the deposit. The rest of the fare is paid at the end of the trip."
msgstr "Sau khi gửi, bạn sẽ được chuyển đến trang thanh toán an toàn của Stripe để trả tiền cọc. Phần còn lại của giá cước được trả khi kết thúc chuyến đi."

msgid "Your details"
msgstr "Thông tin của bạn"

msgid "I agree to be contacted by phone, SMS or email about this booking, and for you to use the mobility and health details I give to arrange the trip."
msgstr "Tôi đồng ý để được liên lạc qua điện thoại, SMS hoặc email về lịch đặt xe này, và đồng ý để quý công ty dùng thông tin về khả năng đi lại và sức khỏe mà tôi cung cấp để sắp xếp chuyến đi."

#. translators: %s: link to the terms page
msgid "I have read and accept the %s."
msgstr "Tôi đã đọc và chấp nhận %s."

msgid "terms and cancellation policy"
msgstr "điều khoản và chính sách hủy chuyến"

msgid "Request booking"
msgstr "Gửi yêu cầu đặt xe"

#. translators: %s: phone link
msgid "Travelling in the next hour? Call %s"
msgstr "Bạn cần đi trong vòng một giờ tới? Xin gọi %s"

msgid "Find your booking"
msgstr "Tìm lịch đặt xe của bạn"

msgid "Enter the reference from your confirmation (it starts with TP-) and the mobile number you booked with."
msgstr "Nhập mã đặt xe trong thư xác nhận (bắt đầu bằng TP-) và số di động bạn đã dùng khi đặt xe."

msgid "Show my booking"
msgstr "Xem lịch đặt xe của tôi"

#. translators: %s: phone link
msgid "Lost your reference? Call %s."
msgstr "Mất mã đặt xe? Xin gọi %s."

msgid "Online deposit"
msgstr "Đặt cọc trực tuyến"

