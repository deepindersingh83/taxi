msgstr ""
"Bạn sẽ nhận tin nhắn khi tài xế đang trên đường đến và khi tài xế đã đến."

msgid "View booking"
msgstr "Xem lịch đặt xe"

msgid "Book the return trip"
msgstr "Đặt chuyến về"

msgid "Make another booking"
msgstr "Đặt thêm chuyến khác"

