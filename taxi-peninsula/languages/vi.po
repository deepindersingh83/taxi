msgid "Need an interpreter? Call TIS National on 131 450 and ask them to call %1$s on %2$s."
msgstr "Bạn cần thông dịch viên? Hãy gọi TIS National theo số 131 450 và nhờ họ gọi cho %1$s theo số %2$s."

msgid "Deaf, hard of hearing or speech impaired? Use the National Relay Service on 133 677."
msgstr "Bạn bị khiếm thính, nghe kém hoặc khó nói? Hãy dùng Dịch vụ Chuyển tiếp Quốc gia (National Relay Service) theo số 133 677."

msgid "Language"
msgstr "Ngôn ngữ"

msgid "Auslan and the National Relay Service"
msgstr "Auslan và Dịch vụ Chuyển tiếp Quốc gia (National Relay Service)"

