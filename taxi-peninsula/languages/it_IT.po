msgid ""
"Please enter an Australian phone number, e.g. 0412 345 678 or (03) 9123 "
"4567."
msgstr ""
"Inserisca un numero di telefono australiano, ad es. 0412 345 678 o (03) 9123"
" 4567."

msgid "Please enter a mobile number starting with 04, so we can send texts."
msgstr ""
"Inserisca un numero di cellulare che inizia con 04, così possiamo inviarle "
"messaggi."

msgid ""
"That looks like a landline — we will call you instead of sending texts."
msgstr "Sembra un numero fisso: la chiameremo invece di inviarle messaggi."
